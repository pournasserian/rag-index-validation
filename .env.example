# Any OpenAI-compatible endpoint. For OpenAI itself, leave OPENAI_BASE_URL unset.
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model ids as the endpoint names them. OpenRouter prefixes OpenAI's ids with "openai/".
# EMBEDDING_MODEL=text-embedding-3-small
# GENERATOR_MODEL=gpt-5-mini
# JUDGE_MODEL=gpt-5.4-mini
